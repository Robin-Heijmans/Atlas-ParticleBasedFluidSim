#include "/Engine/Private/Common.ush"

#include "/Shaders/Compute/Headers/SpatialHash3D.ush"
#include "/Shaders/Compute/Headers/SmoothingKernels.ush"


struct FFluidVolumeLocal {
    // Volume Data
    float3 MinBounds;  // Min Bounds
    float3 MaxBounds;      // Max Bounds
    
};

ConstantBuffer<FFluidVolumeLocal> Bounds;

// Buffers
RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> PredictedPositions;
RWStructuredBuffer<float3> Velocities;
RWStructuredBuffer<float> Densities;
RWStructuredBuffer<uint3> SpatialIndices; //uint3(index, hash, key)
RWStructuredBuffer<uint> SpatialOffsets;

// Settings
float PressureAmplifier;
float TargetDensity;
float CollisionDampening;
float SmoothingRadius;
float ViscosityStrength;
float DeltaTime;
float Gravity;
uint NumParticles;

// Collision Params
float4x4 OtherLocalTransform;
float4x4 OtherLocalTransformInverse;
float3 OtherLocalExtent;
float3 LocalScale;
float3 LocalCenter;

float ConvertDensityToPressure(float Density) {
    return (Density - TargetDensity) * PressureAmplifier;
}

void ResolveCollisions(uint ParticleIndex) {
    float3 LocalPos = Positions[ParticleIndex];
    if (LocalPos.x <= Bounds.MinBounds.x || LocalPos.x >= Bounds.MaxBounds.x) {
        Positions[ParticleIndex].x = clamp(LocalPos.x, Bounds.MinBounds.x, Bounds.MaxBounds.x);
        Velocities[ParticleIndex].x *= -1.f * CollisionDampening;
    }
    if (LocalPos.y <= Bounds.MinBounds.y || LocalPos.y >= Bounds.MaxBounds.y) {
        Positions[ParticleIndex].y = clamp(LocalPos.y, Bounds.MinBounds.y, Bounds.MaxBounds.y);
        Velocities[ParticleIndex].y *= -1.f * CollisionDampening;
    }
    if (LocalPos.z <= Bounds.MinBounds.z || LocalPos.z >= Bounds.MaxBounds.z) {
        Positions[ParticleIndex].z = clamp(LocalPos.z, Bounds.MinBounds.z, Bounds.MaxBounds.z);
        Velocities[ParticleIndex].z *= -1.f * CollisionDampening;
    }
}

float3 ReflectVelocity(float3 Vel, float3 Normal) {
    return Vel - 2.f * dot(Vel, Normal) * (Normal * CollisionDampening);
}

bool CheckBoxCollision(float3 Position, float3 IntersectionMinBounds, float3 IntersectionMaxBounds) {
    if (Position.x < IntersectionMinBounds.x || Position.x > IntersectionMaxBounds.x
    || Position.y < IntersectionMinBounds.y || Position.y > IntersectionMaxBounds.y
    || Position.z < IntersectionMinBounds.z || Position.z > IntersectionMaxBounds.z) {
        return false;
    }
    return true;
}

bool CheckSphereCollision(float Distance, float Radius) {
    return Distance <= Radius;
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void ExternalForces (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    Velocities[id.x] += float3(0, 0, Gravity) * DeltaTime;

    PredictedPositions[id.x] = Positions[id.x] + Velocities[id.x] * 1.0 / 120.0; // Fixed LookAheadTimeStep
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void UpdateSpatialLookup (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    uint index = id.x;
    int3 cell = PositionToCellCoords(PredictedPositions[index], SmoothingRadius);
    uint hash = HashCell(cell);
    uint key = GetKeyFromHash(hash, NumParticles);
    SpatialIndices[id.x] = uint3(index, hash, key);
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void CalculateDensity (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    float3 pos = PredictedPositions[id.x];
    int3 centreCoords = PositionToCellCoords(pos, SmoothingRadius);
    float sqrRadius = SmoothingRadius * SmoothingRadius;

    float density = 0.0f;

    for (int cellOffset = 0; cellOffset < 27; cellOffset++) {
        uint hash = HashCell(centreCoords + offsets3D[cellOffset]);
        uint key = GetKeyFromHash(hash, NumParticles);
        uint currIndex = SpatialOffsets[key];

        for (int i = currIndex; i < NumParticles; i++) {
            uint3 indexData = SpatialIndices[i];

            if (indexData[2] != key) break;
            uint particleIndex = indexData[0];
            float3 offset = PredictedPositions[particleIndex] - pos;
            float sqrDistance = dot(offset, offset);
            if (sqrDistance <= sqrRadius) {
                float distance = sqrt(sqrDistance);
                density += SmoothingKernel(distance, SmoothingRadius); // assuming mass = 1.0f
            }
        }
    }
    Densities[id.x] = density;
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void CalculatePressureForce (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    float3 pos = PredictedPositions[id.x];
    int3 centreCoords = PositionToCellCoords(pos, SmoothingRadius);
    float sqrRadius = SmoothingRadius * SmoothingRadius;

    float density = Densities[id.x];
    float pressure = ConvertDensityToPressure(density);
    float3 pressureForce = float3(0.0f, 0.0f, 0.0f);

    for (int cellOffset = 0; cellOffset < 27; cellOffset++) {
        uint hash = HashCell(centreCoords + offsets3D[cellOffset]);
        uint key = GetKeyFromHash(hash, NumParticles);
        uint currIndex = SpatialOffsets[key];

        for (int i = currIndex; i < NumParticles; i++) {
            uint3 indexData = SpatialIndices[i];

            if (indexData[2] != key) break;
            if (indexData[0] == id.x) continue;
            //if (indexData[1] != hash) continue;
            uint particleIndex = indexData[0];
            float3 offset = PredictedPositions[particleIndex] - pos;
            float sqrDistance = dot(offset, offset);
            if (sqrDistance <= sqrRadius) {
                float distance = sqrt(sqrDistance);
                float3 direction = distance == 0 ? float3(0.0f, 0.0f, 1.0f) : offset / distance;
                float slope = SmoothingKernelDerivative(distance, SmoothingRadius);
                float sharedPressure = (ConvertDensityToPressure(Densities[particleIndex]) + pressure) * 0.5f;
                pressureForce += sharedPressure * direction * slope / min(density, 0.2f);
            }
        }
    }
    float3 pressureAcceleration = -pressureForce / density;
    Velocities[id.x] += pressureAcceleration * DeltaTime;
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void CalculateViscosityForce (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    float3 pos = PredictedPositions[id.x];
    int3 centreCoords = PositionToCellCoords(pos, SmoothingRadius);
    float sqrRadius = SmoothingRadius * SmoothingRadius;

    float3 viscosityForce = float3(0.0f, 0.0f, 0.0f);
    float3 velocity = Velocities[id.x];

    for (int cellOffset = 0; cellOffset < 27; cellOffset++) {
        uint hash = HashCell(centreCoords + offsets3D[cellOffset]);
        uint key = GetKeyFromHash(hash, NumParticles);
        uint currIndex = SpatialOffsets[key];

        for (int i = currIndex; i < NumParticles; i++) {
            uint3 indexData = SpatialIndices[i];

            if (indexData[2] != key) break;
            if (indexData[0] == id.x) continue;
            //if (indexData[1] != hash) continue;
            uint particleIndex = indexData[0];
            float3 offset = PredictedPositions[particleIndex] - pos;
            float sqrDistance = dot(offset, offset);
            if (sqrDistance <= sqrRadius) {
                float distance = sqrt(sqrDistance);
                viscosityForce += (Velocities[particleIndex] - velocity) * SmoothingKernelViscosity(distance, SmoothingRadius); // assuming mass = 1.0f
            }
        }
    }
    Velocities[id.x] += viscosityForce * ViscosityStrength * DeltaTime; 
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void UpdatePositions (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    Positions[id.x] += Velocities[id.x] * DeltaTime;
    ResolveCollisions(id.x);
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void ResolveBoxCollisions (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    float3 Pos = Positions[id.x];
    float3 Offset = mul(float4(Pos, 1.0f), OtherLocalTransformInverse).xyz;
    if (CheckBoxCollision(Offset, -OtherLocalExtent, OtherLocalExtent)) {
        float3 Vel = Velocities[id.x];
        float3 Direction = normalize(Offset);

        float3 AbsDir = abs(Direction);
        float AxisBound = 0.f;
        float Distance = 0.f;
        if (AbsDir.x > AbsDir.y && AbsDir.x > AbsDir.z) {
            float3 localAxis = float3(sign(Direction.x), 0, 0);
            Direction = normalize(mul(float4(localAxis, 0), OtherLocalTransform).xyz);
            AxisBound = OtherLocalExtent.x;
            Distance = abs(Offset.x);
        }
        else if (AbsDir.y > AbsDir.z) {
            float3 localAxis = float3(0, sign(Direction.y), 0);
            Direction = normalize(mul(float4(localAxis, 0), OtherLocalTransform).xyz);
            AxisBound = OtherLocalExtent.y;
            Distance = abs(Offset.y);
        }
        else {
            float3 localAxis = float3(0, 0, sign(Direction.z));
            Direction = normalize(mul(float4(localAxis, 0), OtherLocalTransform).xyz);
            AxisBound = OtherLocalExtent.z;
            Distance = abs(Offset.z);
        }
        float3 OnSurfaceWorld = ((AxisBound - Distance)) * LocalScale * Direction;
        Positions[id.x] += OnSurfaceWorld;
        Velocities[id.x] = ReflectVelocity(Vel, Direction);
    }
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void ResolveSphereCollisions (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    float3 Pos = Positions[id.x];
    float3 Offset = mul(float4(Pos, 1.0f), OtherLocalTransformInverse).xyz / OtherLocalExtent;
    float Distance = length(Offset);
    if (CheckSphereCollision(Distance, 1.f)) {
        float3 Vel = Velocities[id.x];
        float3 Direction = normalize(mul(float4(Offset/Distance, 0), OtherLocalTransform).xyz); // OtherLocalTransform == NormalMatrix
        float3 OnSurfaceWorld = (1.f - Distance) * LocalScale * Direction; // LocalScale = ObjectExtent
        Positions[id.x] += OnSurfaceWorld;
        Velocities[id.x] = ReflectVelocity(Vel, Direction);
    }
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void ResolveCapsuleCollisions (uint3 id : SV_DispatchThreadID) {
    if (id.x >= NumParticles) return;

    float3 Pos = Positions[id.x];
    // OtherLocalExtent = UpCapsule * HalfHeightCylinder
    float3 Bottom = LocalCenter - OtherLocalExtent;
    float3 Top = LocalCenter + OtherLocalExtent;

    float3 AB = Top - Bottom;
    float3 AP = Pos - Bottom;
    float T = clamp(dot(AP, AB) / dot(AB, AB), 0.f, 1.f);
    float3 ClosestPoint = Bottom + T * AB;

    // LocalScale.x = SphereRadius
    float3 Offset = (Pos - ClosestPoint) / LocalScale.x; 
    float Distance = length(Offset);
    if (CheckSphereCollision(Distance, 1.f)) {
        float3 Vel = Velocities[id.x];
        float3 Direction = Offset/Distance;
        float3 OnSurfaceWorld = (1.f - Distance) * LocalScale.x * Direction;
        Positions[id.x] += OnSurfaceWorld;
        Velocities[id.x] = ReflectVelocity(Vel, Direction);
    }
}