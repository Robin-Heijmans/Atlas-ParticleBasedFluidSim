#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

#include "/Shaders/Compute/Headers/SpatialHash3D.ush"
#include "/Shaders/Compute/Headers/SmoothingKernels.ush"

struct FFluidVolume {
    // Volume Data
    float3 BoundsPosition;
    float3 BoundsSize;
    
};

struct FFluidVolumeLocal {
    // Volume Data
    float3 MinBounds;  // Min Bounds
    float3 MaxBounds;  // Max Bounds    
};

ConstantBuffer<FFluidVolume> FluidVolume;
ConstantBuffer<FFluidVolumeLocal> Bounds;


StructuredBuffer<float3> Positions;
StructuredBuffer<float3> PredictedPositions;
StructuredBuffer<uint3> SpatialIndices; //uint3(index, hash, key)
StructuredBuffer<uint> SpatialOffsets;
uint NumParticles;

RWTexture3D<float> DensityMap;
uint3 DensityMapSize;

static const float K_SpikyPow2 = 15 / (2 * PI * pow(4.0, 5));

float SpikyKernelPow2(float dst, float radius)
{
	if (dst < radius)
	{
		float v = radius - dst;
		return v * v * K_SpikyPow2;
	}
	return 0;
}

float CalcDensity(float3 pos)
{
    float SmoothingRadius = 3.0;

    int3 centreCoords = PositionToCellCoords(pos, SmoothingRadius);
    float sqrRadius = SmoothingRadius * SmoothingRadius;

    float density = 0.0f;

    for (int cellOffset = 0; cellOffset < 27; cellOffset++) {
        uint hash = HashCell(centreCoords + offsets3D[cellOffset]);
        uint key = GetKeyFromHash(hash, NumParticles);
        uint currIndex = SpatialOffsets[key];

        for (int i = currIndex; i < NumParticles; i++) {
            uint3 indexData = SpatialIndices[i];

            if (indexData[2] != key) break;
            uint particleIndex = indexData[0];
            float3 offset = PredictedPositions[particleIndex] - pos;
            float sqrDistance = dot(offset, offset);
            if (sqrDistance <= sqrRadius) {
                float distance = sqrt(sqrDistance);
                density += SpikyKernelPow2(distance, SmoothingRadius); // assuming mass = 1.0f
            }
        }
    }
    return density;
}


[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void Compute(
	uint3 DispatchThreadId : SV_DispatchThreadID,
	uint GroupIndex : SV_GroupIndex)
{    
    if (DispatchThreadId.x >= DensityMapSize.x || 
        DispatchThreadId.y >= DensityMapSize.y || 
        DispatchThreadId.z >= DensityMapSize.z)
        return;

    const float3 UVW = (float3(DispatchThreadId)) / DensityMapSize;
    const float density = CalcDensity((UVW - 0.5) * (Bounds.MaxBounds * 2.0));

    DensityMap[DispatchThreadId] = density;
}