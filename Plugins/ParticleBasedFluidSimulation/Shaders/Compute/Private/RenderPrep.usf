#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

#include "/Shaders/Compute/Headers/Common.ush"

//ConstantBuffer<FParticles> FluidParticles;

StructuredBuffer<float3> Positions;
uint NumParticles;

RWTexture3D<float3> DensityMap;
uint DensityMapSize;

bool SphereIntersection(float3 sphere, float radius, float3 against)
{
    float champion = length(sphere - against);
    return champion < radius;
}

float CalcDensity(float3 UVW)
{
    const float particle_radius = 0.1;
    const float influence = 10.0;
    for(int i = 0; i < NumParticles; i++)
    {
        if(SphereIntersection(Positions[i], particle_radius, UVW))
        {
            return influence;
        }
    }
    return 0.0;
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void Compute(
	uint3 DispatchThreadId : SV_DispatchThreadID,
	uint GroupIndex : SV_GroupIndex)
{
    const float3 UVW = (float3(DispatchThreadId)) / float3(DensityMapSize, DensityMapSize, DensityMapSize);
    const float density = CalcDensity(UVW);

    DensityMap[DispatchThreadId] = float3(density, density, density);
}