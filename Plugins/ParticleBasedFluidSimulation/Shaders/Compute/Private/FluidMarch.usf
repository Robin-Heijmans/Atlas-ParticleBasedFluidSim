#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

struct FFluidVolume {
    // Volume Data
    float3 BoundsPosition;
    float3 BoundsSize;
    
};

struct FFluidVolumeLocal {
    // Volume Data
    float3 MinBounds;  // Min Bounds
    float3 MaxBounds;  // Max Bounds    
};

ConstantBuffer<FFluidVolume> FluidVolume;
ConstantBuffer<FFluidVolumeLocal> Bounds;

Texture3D<float> DensityMap;
uint3 DensityMapSize;

Texture2D<float3> SceneColor;
RWTexture2D<float3> Target;

const float SampleDensity(const float3 RayPos)
{
    const float3 UVW = (RayPos - FluidVolume.BoundsPosition) / FluidVolume.BoundsSize * 0.5 + 0.5;
    const float Density = DensityMap.SampleLevel(GlobalBilinearClampedSampler, UVW, 0);
    return Density;
}

float2 GetPixelUV(const uint2 Pixel) { return (float2(Pixel) + 0.5 - View.TemporalAAJitter.xy) * View.ViewSizeAndInvSize.zw; }

float3 GetRayOrigin() { return View.WorldViewOriginHigh + View.WorldViewOriginLow; }

float3 GetRayDirection(float2 UV)
{
    float2 NDC = (UV - 0.5) * 2.0;
    NDC.y = -NDC.y;
    
    // Unproject from clip space to view space
    const float4 ClipPos = float4(NDC, 1.0f, 1.0f);
    float4 ViewPos = mul(ClipPos, View.ClipToView);
    ViewPos.xyz /= ViewPos.w;
    
    // Transform view space direction to world space
    return normalize(mul(float4(ViewPos.xyz, 0.0f), View.ViewToTranslatedWorld).xyz);
}

float CubeIntersect(const float3 RayO, const float3 RayD)
{
    float3 RayrD = float3(
		1.0 / (RayD.x),
		1.0 / (RayD.y),
		1.0 / (RayD.z));

    // Compute t-min and t-max for each axis (X, Y, Z)
    float tmin = ((FluidVolume.BoundsPosition - FluidVolume.BoundsSize).x - RayO.x) * RayrD.x;
    float tmax = ((FluidVolume.BoundsPosition + FluidVolume.BoundsSize).x - RayO.x) * RayrD.x;

    if (tmin > tmax) {
        // Swap if tmin is greater than tmax
        float temp = tmin;
        tmin = tmax;
        tmax = temp;
    }

    // Check for intersection along the Y axis
    float tymin = ((FluidVolume.BoundsPosition - FluidVolume.BoundsSize).y - RayO.y) * RayrD.y;
    float tymax = ((FluidVolume.BoundsPosition + FluidVolume.BoundsSize).y - RayO.y) * RayrD.y;

    if (tymin > tymax) {
        // Swap if tymin is greater than tymax
        float temp = tymin;
        tymin = tymax;
        tymax = temp;
    }

    // Update tmin and tmax for the intersection of X and Y planes
    if (tmin > tymax || tymin > tmax)
        return -1.0;  // No intersection

    // Update tmin and tmax based on the Y-axis bounds
    tmin = max(tmin, tymin);
    tmax = min(tmax, tymax);

    // Check for intersection along the Z axis
    float tzmin = ((FluidVolume.BoundsPosition - FluidVolume.BoundsSize).z - RayO.z) * RayrD.z;
    float tzmax = ((FluidVolume.BoundsPosition + FluidVolume.BoundsSize).z - RayO.z) * RayrD.z;

    if (tzmin > tzmax) {
        // Swap if tzmin is greater than tzmax
        float temp = tzmin;
        tzmin = tzmax;
        tzmax = temp;
    }

    // Update tmin and tmax for the intersection of X, Y, and Z planes
    if (tmin > tzmax || tzmin > tmax)
        return -1.0;  // No intersection

    // Final tmin and tmax after checking all axes
    tmin = max(tmin, tzmin);
    tmax = min(tmax, tzmax);

    // If tmax is less than 0, the cube is behind the ray, no intersection
    if (tmax < 0.0)
        return -1.0;  // No intersection

    // Return the closest positive intersection distance
    if (tmin < 0.0)
        return tmax;  // If tmin is negative, we hit the cube from behind, so return tmax
    return tmin;  // Otherwise, return tmin
}

bool CubeContains(const float3 RayPos)
{
    return
		RayPos.x >= (FluidVolume.BoundsPosition - FluidVolume.BoundsSize).x &&
		RayPos.y >= (FluidVolume.BoundsPosition - FluidVolume.BoundsSize).y &&
		RayPos.z >= (FluidVolume.BoundsPosition - FluidVolume.BoundsSize).z &&
		RayPos.x <= (FluidVolume.BoundsPosition + FluidVolume.BoundsSize).x &&
		RayPos.y <= (FluidVolume.BoundsPosition + FluidVolume.BoundsSize).y &&
		RayPos.z <= (FluidVolume.BoundsPosition + FluidVolume.BoundsSize).z;
}

float2 RayBoxDst(float3 rayOrigin, float3 rayDir)
{
    float3 invRayDir = 1 / rayDir;
    // Adapted from: http://jcgt.org/published/0007/03/04/
    float3 t0 = ((-32) - (rayOrigin - FluidVolume.BoundsPosition)) * invRayDir;
    float3 t1 = (( 32) - (rayOrigin - FluidVolume.BoundsPosition)) * invRayDir;
    float3 tmin = min(t0, t1);
    float3 tmax = max(t0, t1);

    float dstA = max(max(tmin.x, tmin.y), tmin.z);
    float dstB = min(tmax.x, min(tmax.y, tmax.z));

    // CASE 1: ray intersects box from outside (0 <= dstA <= dstB)
    // dstA is dst to nearest intersection, dstB dst to far intersection

    // CASE 2: ray intersects box from inside (dstA < 0 < dstB)
    // dstA is the dst to intersection behind the ray, dstB is dst to forward intersection

    // CASE 3: ray misses box (dstA > dstB)

    float dstToBox = max(0, dstA);
    float dstInsideBox = max(0, dstB - dstToBox);
    return float2(dstToBox, dstInsideBox);
}

bool FluidContains(const float3 RayPos)
{
    float2 boundsDstInfo = RayBoxDst(RayPos, float3(0, 0, 1));
    return (boundsDstInfo.x <= 0 && boundsDstInfo.y > 0) && SampleDensity(RayPos) > 0;
}


[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void Compute(
	uint3 DispatchThreadId : SV_DispatchThreadID,
	uint GroupIndex : SV_GroupIndex )
{
    // Calculate the pixel coordinate of this thread.
    const uint2 Pixel = View.ViewRectMinAndSize.xy + DispatchThreadId.xy;
    
	// Make sure this pixel isn't outside the viewport bounds.
    if (any(Pixel >= View.ViewRectMinAndSize.zw)) return;
	
    // Calculate the UV coordinate of the current pixel.
    const float2 UV = GetPixelUV(Pixel);
    float3 RayOrigin = GetRayOrigin();
    float3 RayDirection = GetRayDirection(UV);
    float RayT = 0;

    // Advance ray if not in volume
    if(!CubeContains(RayOrigin))
    {
        RayT = CubeIntersect(RayOrigin, RayDirection);
        if(RayT <= 0.0) 
        {
            Target[DispatchThreadId.xy] = SceneColor[DispatchThreadId.xy];
            return;
        }
    }

    // Psuedo Stepping through Density Map
    uint NumSteps = 1;
    float AccDensity = 0;
    float StepSize = 0.02;
    
    do
    {
        const float3 CurrPos = RayOrigin + (RayDirection * RayT);
        const float Density = SampleDensity(CurrPos);
        if(Density > 0.0)
        { 
            AccDensity += Density;
            NumSteps++;
        }

        RayT += StepSize;
    } while(CubeContains(RayOrigin + (RayDirection * RayT)));

    float3 OutColor = AccDensity / NumSteps;
    OutColor += SceneColor[DispatchThreadId.xy];

    Target[DispatchThreadId.xy] = OutColor;
}