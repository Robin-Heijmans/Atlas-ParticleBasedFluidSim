// Most of this implementation is taken from Sebastian Lagues fluid simulation videos
// https://github.com/ICE-5/fluid-unity/tree/main

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"

//#define STEP_VISUAL
//#define NORMAL_VISUAL
//#define TWO_LEVEL_STEPPING
#define MARCH_STEP_ADJUSTMENT
#define DENSITY_STEP_ADJUSTMENT
//#define REFLECTION_ONLY
//#define REFLECTION_NORMAL // need to be used together with REFLECTION_ONLY

struct FFluidVolume {
    // Volume Data
    float3 BoundsPosition;
    float3 BoundsSize;
    
};

struct FFluidVolumeLocal {
    // Volume Data
    float3 MinBounds;  // Min Bounds
    float3 MaxBounds;  // Max Bounds    
};

struct FFluidEnvironment {    
    float4x4 CubeLocalToWorld;
    float4x4 CubeWorldToLocal;
    float3 ExtinctionCoeff;
    float MarchStepSize;
    float LightStepSize;
    float DensityStepSize;
    float DensityMultiplier;
    float indexOfRefraction;
    uint NumRefractions;
};

ConstantBuffer<FFluidVolume> FluidVolume;
ConstantBuffer<FFluidVolumeLocal> Bounds;
ConstantBuffer<FFluidEnvironment> Environment;

RWTexture2D<float3> Target;
Texture2D<float3> SceneColor;
Texture2D<float3> SceneDepth;

Texture3D<float> DensityMap;
uint3 DensityMapSize;

static const float TinyNudge = 0.1;
static const float volumeValueOffset = 0.01;

// Optimizations
static const uint MaxSteps = 1500;

#ifdef TWO_LEVEL_STEPPING
static const float StepLevel = 4;
#endif

#ifdef MARCH_STEP_ADJUSTMENT
static const float MarchStepAdjustment = 0.002;
#endif

#ifdef DENSITY_STEP_ADJUSTMENT
static const float DensityStepAdjustment = 0.2;
#endif

static const float iorAir = 1.0;

const float SampleDensity(const float3 RayPos)
{
    // THis WORKS ?!   
    float3 posLocal = RayPos - FluidVolume.BoundsPosition;
    float3 UVW = (posLocal + FluidVolume.BoundsSize * 0.5) / FluidVolume.BoundsSize;

    const float3 epsilon = 0.0001;
    bool isEdge = any(UVW >= 1 - epsilon || UVW <= epsilon);
    if (isEdge) return -volumeValueOffset;

    return DensityMap.SampleLevel(GlobalBilinearClampedSampler, UVW, 0).r - volumeValueOffset;
}
const float3 Transmittance(float thickness)
{
    return exp(-thickness * Environment.ExtinctionCoeff);
}
uint NextRandom(inout uint state)
{
    state = state * 747796405 + 2891336453;
    uint result = ((state >> ((state >> 28) + 4)) ^ state) * 277803737;
    result = (result >> 22) ^ result;
    return result;
}
float RandomValue(inout uint state)
{
    return NextRandom(state) / 4294967295.0; // 2^32 - 1
}

float2 GetPixelUV(const uint2 Pixel) { return (float2(Pixel) + 0.5 - View.TemporalAAJitter.xy) * View.ViewSizeAndInvSize.zw; }

float3 GetRayOrigin() { return View.WorldViewOriginHigh + View.WorldViewOriginLow; }

float3 GetRayDirection(float2 UV)
{
    float2 NDC = (UV - 0.5) * 2.0;
    NDC.y = -NDC.y;
    
    // Unproject from clip space to view space
    const float4 ClipPos = float4(NDC, 1.0f, 1.0f);
    float4 ViewPos = mul(ClipPos, View.ClipToView);
    ViewPos.xyz /= ViewPos.w;
    
    // Transform view space direction to world space
    return normalize(mul(float4(ViewPos.xyz, 0.0f), View.ViewToTranslatedWorld).xyz);
}

// Returns (dstToBox, dstInsideBox). If ray misses box, dstInsideBox will be zero
float2 RayBoxDst(float3 boundsMin, float3 boundsMax, float3 rayOrigin, float3 rayDir)
{
    boundsMin += FluidVolume.BoundsPosition;
    boundsMax += FluidVolume.BoundsPosition;

    float3 invRayDir = 1 / rayDir;
    // Adapted from: http://jcgt.org/published/0007/03/04/
    float3 t0 = (boundsMin - rayOrigin) * invRayDir;
    float3 t1 = (boundsMax - rayOrigin) * invRayDir;
    float3 tmin = min(t0, t1);
    float3 tmax = max(t0, t1);

    float dstA = max(max(tmin.x, tmin.y), tmin.z);
    float dstB = min(tmax.x, min(tmax.y, tmax.z));

    // CASE 1: ray intersects box from outside (0 <= dstA <= dstB)
    // dstA is dst to nearest intersection, dstB dst to far intersection

    // CASE 2: ray intersects box from inside (dstA < 0 < dstB)
    // dstA is the dst to intersection behind the ray, dstB is dst to forward intersection

    // CASE 3: ray misses box (dstA > dstB)

    float dstToBox = max(0, dstA);
    float dstInsideBox = max(0, dstB - dstToBox);
    return float2(dstToBox, dstInsideBox);
}

bool FluidContains(const float3 RayPos)
{
    float2 boundsDstInfo = RayBoxDst(Bounds.MinBounds, Bounds.MaxBounds, RayPos, float3(0, 0, 1));
    return (boundsDstInfo.x <= 0 && boundsDstInfo.y > 0) && SampleDensity(RayPos) > 0;
}

struct HitInfo
{
    bool didHit;
    bool isInside;
    float dst;
    float3 hitPoint;
    float3 normal;
};

struct LightResponse
{
    float3 reflectDir;
    float3 refractDir;
    float reflectWeight;
    float refractWeight;
};

struct SurfaceInfo
{
    float3 pos;
    float3 normal;
    float densityAlongRay;
    bool foundSurface;
};


HitInfo RayBox(float3 LocalPos, float3 dir)
{
    const float3 boxMin = Bounds.MinBounds;
    const float3 boxMax = Bounds.MaxBounds;
    float3 invDir = 1 / dir;

    // Thanks to https://tavianator.com/2011/ray_box.html
    float3 tMin = (boxMin - LocalPos) * invDir;
    float3 tMax = (boxMax - LocalPos) * invDir;
    float3 t1 = min(tMin, tMax);
    float3 t2 = max(tMin, tMax);
    float tNear = max(max(t1.x, t1.y), t1.z);
    float tFar = min(min(t2.x, t2.y), t2.z);

    // Set hit info
    HitInfo hitInfo = (HitInfo)0;
    hitInfo.dst = 1.#INF;
    hitInfo.didHit = tFar >= tNear && tFar > 0;
    hitInfo.isInside = tFar > tNear && tNear <= 0;

    if (hitInfo.didHit)
    {
        float hitDst = hitInfo.isInside ? tFar : tNear;
        float3 hitPos = LocalPos + dir * hitDst;

        hitInfo.dst = hitDst;
        hitInfo.hitPoint = hitPos;

        // Calculate normal
        float3 o = (1 - abs(hitPos));
        float3 absNormal = (o.x < o.y && o.x < o.z) ? float3(1, 0, 0) : (o.y < o.z) ? float3(0, 1, 0) : float3(0, 0, 1);
        hitInfo.normal = absNormal * sign(hitPos) * (hitInfo.isInside ? -1 : 1);
    }

    return hitInfo;
}

HitInfo RayBoxWithMatrix(float3 RayPos, float3 RayDir, float4x4 LocalToWorld, float4x4 WorldToLocal)
{
    float3 posLocal = mul(WorldToLocal, float4(RayPos, 1)).xyz;
    float3 dirLocal = mul(WorldToLocal, float4(RayDir, 0)).xyz;
    HitInfo hitInfo = RayBox(posLocal, dirLocal);
    hitInfo.normal = normalize(mul(LocalToWorld, float4(hitInfo.normal, 0))).xyz;
    hitInfo.hitPoint = mul(LocalToWorld, float4(hitInfo.hitPoint, 1)).xyz;
    if (hitInfo.didHit) hitInfo.dst = length(hitInfo.hitPoint - RayPos);
    return hitInfo;
}

SurfaceInfo FindNextSurface(float3 origin, float3 RayDir, bool findNextFluidEntryPoint, inout uint RNG, float rngWeight, float maxDst, inout uint num_steps)
{
    SurfaceInfo info = (SurfaceInfo)0;
    if (dot(RayDir, RayDir) < 0.5) return info;

    float2 boundsDstInfo = RayBoxDst(Bounds.MinBounds, Bounds.MaxBounds, origin, RayDir);
    float r = (RandomValue(RNG)) * Environment.MarchStepSize * 0.4 * 1.0;
    bool hasExittedFluid = !FluidContains(origin);
    origin = origin + RayDir * (boundsDstInfo.x + r);

#ifdef TWO_LEVEL_STEPPING
    float stepSize = Environment.MarchStepSize * StepLevel;
    float stepSizeFine = Environment.MarchStepSize;
#else
    float stepSize = Environment.MarchStepSize;
#endif

    bool hasEnteredFluid = false;
    float3 lastPosInFluid = origin;

    float dstToTest = boundsDstInfo[1] - (TinyNudge) * 2;

    uint localSteps = 0;
    for (float dst = 0; dst < dstToTest && num_steps + localSteps < MaxSteps; dst += stepSize)
    {
        bool isLastStep = dst + stepSize >= dstToTest;
        float3 samplePos = origin + RayDir * dst;
        float thickness = SampleDensity(samplePos) * Environment.DensityMultiplier * stepSize;
        bool insideFluid = thickness > 0;
        if (insideFluid)
        {
            
#ifdef TWO_LEVEL_STEPPING
            // Trace closer entry point
            for(float stepBack = 0.0; stepBack < StepLevel; stepBack += stepSizeFine)
            {
                //check if we exited fluid
                float3 fineSamplePos = origin + RayDir * (dst - stepBack);
                float fineThickness = SampleDensity(samplePos) * Environment.DensityMultiplier * stepSize;
                bool fineInsideFluid = fineThickness > 0;
                if(!fineInsideFluid) break;

                //continue from last fine point
                samplePos = fineSamplePos;
                thickness = fineThickness;
                insideFluid = fineInsideFluid;
            }
#endif 

            hasEnteredFluid = true;
            lastPosInFluid = samplePos;
            if (dst <= maxDst)
            {
                info.densityAlongRay += thickness;
            }
        }
#ifdef MARCH_STEP_ADJUSTMENT
        else
        {
            stepSize += MarchStepAdjustment * localSteps;
        }
#endif

        if (!insideFluid) hasExittedFluid = true;

        bool found;
        if (findNextFluidEntryPoint) found = insideFluid && hasExittedFluid;
        else found = hasEnteredFluid && (!insideFluid || isLastStep);

        if (found)
        {
            info.pos = lastPosInFluid;
            info.foundSurface = true;
            break;
        }
        
        localSteps++;
    }
    
    num_steps += localSteps;
    return info;
}

float3 CalculateClosestFaceNormal(float3 boxSize, float3 p)
{
    float3 halfSize = boxSize * 0.5;
    float3 o = (halfSize - abs(p));
    return 
    (o.x < o.y && o.x < o.z) ? float3(sign(p.x), 0, 0) : 
    (o.y < o.z) ? float3(0, sign(p.y), 0) : 
    float3(0, 0, sign(p.z));
}

float3 CalculateNormal(float3 RayPos)
{   
    float3 pos = RayPos - FluidVolume.BoundsPosition;

    const float s = 0.1;
    float3 offsetX = float3(1, 0, 0) * s;
    float3 offsetY = float3(0, 1, 0) * s;
    float3 offsetZ = float3(0, 0, 1) * s;

    float dx = SampleDensity(RayPos - offsetX) - SampleDensity(RayPos + offsetX);
    float dy = SampleDensity(RayPos - offsetY) + SampleDensity(RayPos + offsetY);
    float dz = SampleDensity(RayPos - offsetZ) - SampleDensity(RayPos + offsetZ);

    float3 volumeNormal = normalize(float3(dx, dy, dz));

    // Smoothly flatten normals out at boundary edges
    float3 o = pos;
    float faceWeight = min(o.x, min(o.y, o.z));
    float3 faceNormal = normalize(CalculateClosestFaceNormal(FluidVolume.BoundsSize, pos));
    const float smoothDst = 0.3;
    const float smoothPow = 5;
    faceWeight = (1 - smoothstep(0, smoothDst, faceWeight)) * (1 - pow(saturate(volumeNormal.y), smoothPow));

    return normalize(volumeNormal * (1 - faceWeight) + faceNormal * (faceWeight));
}

float CalculateDensityAlongRay(float3 RayPos, float3 RayDir, float stepSize, inout uint num_steps)
{
    // Test for non-normalize ray and return 0 in that case.
    // This happens when refract direction is calculated, but ray is totally reflected
    if (dot(RayDir, RayDir) < 0.9) return 0;

    float2 boundsDstInfo = RayBoxDst(Bounds.MinBounds, Bounds.MaxBounds, RayPos, RayDir);
    float dstToBounds = boundsDstInfo[0];
    float dstThroughBounds = boundsDstInfo[1];
    if (dstThroughBounds <= 0) return 0;

    float dstTravelled = 0;
    float opticalDepth = 0;
    float nudge = stepSize * 0.5;
    float3 entryPoint = RayPos + RayDir * (dstToBounds + nudge);
    dstThroughBounds -= (nudge + TinyNudge);

    while (dstTravelled < dstThroughBounds && num_steps < MaxSteps)
    {
        RayPos = entryPoint + RayDir * dstTravelled;
        float density = SampleDensity(RayPos) * Environment.DensityMultiplier * stepSize;
        if (density > 0)
        {
            opticalDepth += density;
        }
        dstTravelled += stepSize;
        num_steps++;

#ifdef DENSITY_STEP_ADJUSTMENT
        stepSize += DensityStepAdjustment;
#endif
    }

    return opticalDepth;
}

// Calculate the proportion of light that is reflected at the boundary between two media (via the fresnel equations)
// Note: the amount of light refracted can be calculated as 1 minus this value
float CalculateReflectance(float3 inDir, float3 normal, float iorA, float iorB)
{
    float refractRatio = iorA / iorB;
    float cosAngleIn = -dot(inDir, normal);
    float sinSqrAngleOfRefraction = refractRatio * refractRatio * (1 - cosAngleIn * cosAngleIn);
    if (sinSqrAngleOfRefraction >= 1) return 1; // Ray is fully reflected, no refraction occurs

    float cosAngleOfRefraction = sqrt(1 - sinSqrAngleOfRefraction);
    // Perpendicular polarization
    float rPerpendicular = (iorA * cosAngleIn - iorB * cosAngleOfRefraction) / (iorA * cosAngleIn + iorB * cosAngleOfRefraction);
    rPerpendicular *= rPerpendicular;
    // Parallel polarization
    float rParallel = (iorB * cosAngleIn - iorA * cosAngleOfRefraction) / (iorB * cosAngleIn + iorA * cosAngleOfRefraction);
    rParallel *= rParallel;

    // Return the average of the perpendicular and parallel polarizations
    return (rPerpendicular + rParallel) / 2;
}

float3 Refract(float3 inDir, float3 normal, float iorA, float iorB)
{
    float refractRatio = iorA / iorB;
    float cosAngleIn = -dot(inDir, normal);
    float sinSqrAngleOfRefraction = refractRatio * refractRatio * (1 - cosAngleIn * cosAngleIn);
    if (sinSqrAngleOfRefraction > 1) return 0; // Ray is fully reflected, no refraction occurs

    float3 refractDir = refractRatio * inDir + (refractRatio * cosAngleIn - sqrt(1 - sinSqrAngleOfRefraction)) * normal;
    return refractDir;
}

float3 Reflect(float3 inDir, float3 normal)
{
    return dot(inDir, normal);
}

LightResponse CalculateReflectionAndRefraction(float3 inDir, float3 normal, float iorA, float iorB)
{
    LightResponse result;

    result.reflectWeight = CalculateReflectance(inDir, normal, iorA, iorB);
    result.refractWeight = 1 - result.reflectWeight;

    result.reflectDir = Reflect(inDir, normal);
    result.refractDir = Refract(inDir, normal, iorA, iorB);

    return result;
}

float Modulo(float x, float y)
{
    return (x - y * floor(x / y));
}

uint HashInt2(int2 v)
{
    return v.x * 5023 + v.y * 96456;
}

float3 RGBToHSV(float3 rgb)
{
    // Thanks to http://lolengine.net/blog/2013/07/27/rgb-to-hsv-in-glsl
    float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    float4 p = rgb.g < rgb.b ? float4(rgb.bg, K.wz) : float4(rgb.gb, K.xy);
    float4 q = rgb.r < p.x ? float4(p.xyw, rgb.r) : float4(rgb.r, p.yzx);

    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

float3 HSVToRGB(float3 hsv)
{
    // Thanks to http://lolengine.net/blog/2013/07/27/rgb-to-hsv-in-glsl
    float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    float3 p = abs(frac(hsv.xxx + K.xyz) * 6.0 - K.www);
    return hsv.z * lerp(K.xxx, saturate(p - K.xxx), hsv.y);
}

float3 TweakHSV(float3 colRGB, float hueShift, float satShift, float valShift)
{
    float3 hsv = RGBToHSV(colRGB);
    return saturate(HSVToRGB(hsv + float3(hueShift, satShift, valShift)));
}

float3 TweakHSV(float3 colRGB, float3 shift)
{
    float3 hsv = RGBToHSV(colRGB);
    return saturate(HSVToRGB(hsv + shift));
}

float map(float value, float min1, float max1, float min2, float max2) {
  return min2 + (value - min1) * (max2 - min2) / (max1 - min1);
}

float3 SampleEnvironment(float3 pos, float3 dir, float3 Scene, float Depth)
{
    return Scene;
}

float3 Light(float3 pos, float3 dir, float3 Scene, float Depth)
{
    return SampleEnvironment(pos, dir, Scene, Depth);
}

float3 ReflectedSSR(float3 pos, float3 dir, float3 Scene, float Depth)
{
#ifdef REFLECTION_NORMAL
    return dir;
#endif

    // Do SSR here march in world space, sample from viewport

    // dummy values for now TODO: check with unreals metrics later
    const float _MaxDistance = 100.0;
    const float _Step = Environment.LightStepSize;
    const float _Thickness = 0.0006;

    float2 reflectionUV = 0.0;

    float3 marchReflection;
    float currentDepth = Depth;
    bool SSRused = false;
    for(float i = _Step; i < _MaxDistance; i+= _Step) {
        marchReflection = i * dir;

        float4 clip = mul(float4(pos + marchReflection, 1.0), View.TranslatedWorldToClip);
        //float2 target = (clip.rgba / clip.a).xy;
        float2 target = clip.xy;
        
        float sampledDepth = SceneDepth.SampleLevel(GlobalPointClampedSampler, target, 0).r;
        float depthDiff = (currentDepth - sampledDepth);
        if(depthDiff > 0.0 && depthDiff < (currentDepth) + _Thickness) 
        {
            reflectionUV = target;
            SSRused = true;
            break;
        }

        currentDepth = sampledDepth;
        if(currentDepth > 10.0) 
        {
            break;
        }
    }


    if(SSRused)
    {
        float3 SSRColor = SceneColor.SampleLevel(GlobalBilinearClampedSampler, reflectionUV, 0).xyz;
        return SSRColor;
    }
    else
        return float3(0,0,0);
}

float3 FluidMarch(float3 RayPos, float3 RayDir, float3 Scene, float Depth, uint UVRNG)
{
    bool bInsideFluid = FluidContains(RayPos);

    float3 transmittance = 1;
    float3 light = 0;
    
    uint num_steps = 0;

    for (int i = 0; i < Environment.NumRefractions; i++)
    {
        float densityStepSize = Environment.DensityStepSize * (i + 1); // increase step size with each iteration
        bool searchForNextFluidEntryPoint = !bInsideFluid;
    
        HitInfo CubeHit = RayBoxWithMatrix(RayPos, RayDir, Environment.CubeLocalToWorld, Environment.CubeWorldToLocal);
        SurfaceInfo surfaceInfo = FindNextSurface(RayPos, RayDir, searchForNextFluidEntryPoint, UVRNG, i == 0 ? 1 : 0, CubeHit.dst, num_steps);
        bool useCubeHit = CubeHit.didHit && CubeHit.dst < length(surfaceInfo.pos - RayPos);
        
        if (!surfaceInfo.foundSurface) break;

        // check for occlusion on the first iteration
        if(!i)
        {
            // transpose world scene depth to space distance
            float3 surfaceDistance = ((surfaceInfo.pos - GetRayOrigin()));
            float surfaceDepth = length(surfaceDistance);
            if (surfaceDepth >= ConvertToDeviceZ(Depth))
            {
                return Scene;
            }
        }

#ifndef REFLECTION_ONLY
        transmittance *= Transmittance(surfaceInfo.densityAlongRay);

        // Hit test cube
        if (useCubeHit)
        {
            if (bInsideFluid)
            {
                transmittance *= Transmittance(CalculateDensityAlongRay(CubeHit.hitPoint, CubeHit.normal, densityStepSize, num_steps));
            }
            light += Light(RayPos, RayDir, Scene, Depth) * transmittance;
            transmittance = 0;
            break;
        }

        // If light hits the floor it will be scattered in all directions (in hemisphere)
        // Not sure how to handle this in real-time, so just break out of loop here
        if (surfaceInfo.pos.y < Bounds.MinBounds.y + 0.05)
        {
            break;
        }
#endif        

        float3 normal = CalculateNormal(surfaceInfo.pos);
        if (dot(normal, RayDir) > 0) normal = -normal;

#ifdef NORMAL_VISUAL
        return abs(normal);
#endif

        // Indicies of refraction
        float iorA = bInsideFluid ? Environment.indexOfRefraction : iorAir;
        float iorB = bInsideFluid ? iorAir : Environment.indexOfRefraction;

        // Calculate reflection and refraction, and choose which path to follow
        LightResponse lightResponse = CalculateReflectionAndRefraction(RayDir, normal, iorA, iorB);
        float densityAlongRefractRay = CalculateDensityAlongRay(surfaceInfo.pos, lightResponse.refractDir, densityStepSize, num_steps);
        float densityAlongReflectRay = CalculateDensityAlongRay(surfaceInfo.pos, lightResponse.reflectDir, densityStepSize, num_steps);
        bool traceRefractedRay = densityAlongRefractRay * lightResponse.refractWeight > densityAlongReflectRay * lightResponse.reflectWeight;
        bInsideFluid = traceRefractedRay != bInsideFluid;

        // Approximate less interesting path
        if (traceRefractedRay) light += ReflectedSSR(surfaceInfo.pos, lightResponse.reflectDir, Scene, Depth) * transmittance * Transmittance(densityAlongReflectRay) * lightResponse.reflectWeight;
        else light += ReflectedSSR(surfaceInfo.pos, lightResponse.refractDir, Scene, Depth) * transmittance * Transmittance(densityAlongRefractRay) * lightResponse.refractWeight;

        // Set up ray for more interesting path
        RayPos = surfaceInfo.pos;
        RayDir = traceRefractedRay ? lightResponse.refractDir : lightResponse.reflectDir;
        transmittance *= (traceRefractedRay ? lightResponse.refractWeight : lightResponse.reflectWeight);

    }
#ifndef REFLECTION_ONLY
    // Approximate remaining path
    uint dummy = 0;
    float densityRemainder = CalculateDensityAlongRay(RayPos, RayDir, Environment.LightStepSize, dummy);
    light += Light(RayPos, RayDir, Scene, Depth) * transmittance * Transmittance(densityRemainder);
#endif

#ifdef STEP_VISUAL
    if(num_steps > 0)
    {
        float3 step_visual = float3(num_steps / MaxSteps, 0, 0);
        light += step_visual;
        return step_visual;
    }
#endif

    return light;
}


[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void Compute(
	uint3 DispatchThreadId : SV_DispatchThreadID,
	uint GroupIndex : SV_GroupIndex )
{
    // Calculate the pixel coordinate of this thread.
    const uint2 Pixel = View.ViewRectMinAndSize.xy + DispatchThreadId.xy;
    
	// Make sure this pixel isn't outside the viewport bounds.
    if (any(Pixel >= View.ViewRectMinAndSize.zw)) return;
	
    // Calculate the UV coordinate of the current pixel.
    const float2 UV = GetPixelUV(Pixel);
    float3 RayOrigin = GetRayOrigin();
    float3 RayDirection = GetRayDirection(UV);

    float3 FluidColor = FluidMarch(RayOrigin, RayDirection, SceneColor[DispatchThreadId.xy], SceneDepth[DispatchThreadId.xy].r, (uint)(UV.x * 1243 + UV.y * 96456));
    Target[DispatchThreadId.xy] = FluidColor;
}